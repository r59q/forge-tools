# Copy to .env and fill in. Never commit .env.
# Back up the key separately: losing it loses the stored forge credentials.
FORGE_BROKER_KEY=
FORGE_BROKER_ADMIN_TOKEN=
# Set after creating the proxy's client in the broker.
FORGE_PROXY_TOKEN=
# true lets the proxy forward pushes; forge-code writes need it.
FORGE_PROXY_ALLOW_GIT_PUSH=false
# For the forge-code service: callers' token, and its broker client token.
FORGE_CODE_TOKEN=
FORGE_CODE_CONNECTOR_TOKEN=
