# Settings for the dev stack. Copy to .env and fill in;
# npm run dev:setup adds the service secrets.

# Forge kind: github, gitlab or forgejo.
FORGE_DEV_FORGE=github
# Self-hosted forge host, such as git.example.com. Leave empty for
# github.com, gitlab.com or codeberg.org.
FORGE_DEV_HOST=
# Forge access token with read access to the repositories.
FORGE_DEV_TOKEN=
# Repositories to explore, as owner/name, separated by spaces.
FORGE_DEV_REPOSITORIES=r59q/forge-tools
# Branch, tag or commit to check out.
FORGE_DEV_REFERENCE=HEAD

# Where `npm run dev` finds the explorer service.
EXPLORER_URL=http://127.0.0.1:8190
