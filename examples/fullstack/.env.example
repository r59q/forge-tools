# Run ./init-env.sh to create .env with random values. Do not commit .env.
# Back up FORGE_BROKER_KEY: losing it loses the stored forge tokens.
FORGE_BROKER_KEY=
FORGE_BROKER_ADMIN_TOKEN=
FORGE_MANAGEMENT_TOKEN=
FORGE_PROXY_TOKEN=
FORGE_REPOSITORIES_CONNECTOR_TOKEN=
FORGE_REPOSITORIES_TOKEN=
FORGE_ISSUES_CONNECTOR_TOKEN=
FORGE_ISSUES_TOKEN=
FORGE_CHECKOUTS_CONNECTOR_TOKEN=
FORGE_CHECKOUTS_TOKEN=

# Pipeline service and its connector client.
FORGE_ACTIONS_TOKEN=
FORGE_ACTIONS_CONNECTOR_TOKEN=
# Trusted HTTPS download hosts; no credentials are sent to these hosts.
FORGE_PROXY_DOWNLOAD_HOSTS=*.blob.core.windows.net,*.actions.githubusercontent.com
