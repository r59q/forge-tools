"""Module docstring."""

import os
from typing import TypeAlias

MAX_SIZE = 10
_PRIVATE_LIMIT: int = 20
logger = make_logger(__name__)
first, second = 1, 2

type Pair = tuple[int, int]
type Box[T] = list[T]


def top_level(path):
    def helper(name):
        return os.path.join(path, name)

    return helper("x")


async def fetch(url):
    return await download(url)


class Config(Base, metaclass=Meta):
    """A class with fields and methods."""

    DEFAULT = "on"
    name: str
    count: int = 0

    def __init__(self, name):
        self.name = name
        local = 1

    async def load(self):
        return await self.reader.read()

    @property
    def title(self):
        return self.name.title()

    @staticmethod
    @cache
    def parse(text):
        return Config(text.strip())

    @classmethod
    def create(cls):
        return cls("default")


def after_class():
    return lambda value: value
