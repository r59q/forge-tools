{
  "name": "@r59q/sinterguild-connection",
  "version": "0.1.0",
  "description": "Forge connection setup for SinterGuild",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
