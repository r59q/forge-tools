# Generate a distinct random value for each secret. Do not commit .env.
FORGE_MANAGEMENT_TOKEN=
FORGE_REPOSITORIES_TOKEN=
FORGE_BROKER_KEY=
FORGE_BROKER_ADMIN_TOKEN=
